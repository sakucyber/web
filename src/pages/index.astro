---
/**
 * 首页
 * 结构：Hero / 关于 / 作品精选 / 画廊预览 / 最新文章 / 社交
 * 沉浸式整屏区块沿用旧站视觉，但图片全部走 Astro 图片管线（AVIF/WebP + srcset）。
 */
import { Picture } from 'astro:assets';
import { SITE } from '@/config/site';
import { getPosts, getWorks, getFeaturedWorks } from '@/lib/content';
import { HERO_IMAGES, images } from '@/lib/images';
import { HOME_PREVIEW_ITEMS } from '@/data/gallery';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkCard from '@/components/WorkCard.astro';
import PostCard from '@/components/PostCard.astro';
import GalleryGrid from '@/components/GalleryGrid.astro';
import Icon from '@/components/Icon.astro';

const posts = await getPosts();
const works = await getWorks();
const featuredWorks = getFeaturedWorks(works, 2);
const latestPosts = posts.slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    alternateName: SITE.shortTitle,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'zh-CN',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE.url}/search?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    sameAs: SITE.socials.filter((s) => s.icon !== 'mail').map((s) => s.href),
  },
];
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  image={HERO_IMAGES.home}
  preloadImage={HERO_IMAGES.home}
  jsonLd={jsonLd}
  bodyClass="page-home"
>
  <!-- Hero -->
  <section class="hero hero--full home-hero" id="home">
    <div class="hero-bg" data-parallax="hero">
      <Picture
        src={HERO_IMAGES.home}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[800, 1600]}
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        quality={80}
      />
    </div>

    <div class="hero-content">
      <div class="hero-badge" data-anim="fade-up" data-delay style="--d:0">{SITE.hero.badge}</div>
      <div class="hero-avatar" data-anim="scale" data-delay style="--d:1">
        <Picture
          src={images.avatar}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[140, 280]}
          sizes="140px"
          alt="buling 的头像"
          loading="eager"
          quality={82}
        />
      </div>
      <h1 data-anim="fade-up" data-delay style="--d:2">
        {SITE.hero.title}
        <span class="accent">{SITE.hero.accent}</span>
      </h1>
      <p data-anim="fade-up" data-delay style="--d:3">
        {
          SITE.hero.subtitle.split('\n').map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))
        }
      </p>
      <div class="hero-tags" data-anim="fade-up" data-delay style="--d:4">
        {SITE.hero.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </div>

    <a class="hero-scroll" href="#about" aria-label="向下滚动到关于">
      <span>SCROLL</span>
      <Icon name="chevron-down" size={18} />
    </a>

    <div class="sparkles" aria-hidden="true">
      <span class="spk" style="top:10%;left:6%;animation-delay:0s">✨</span>
      <span class="spk" style="top:22%;right:10%;animation-delay:-1.5s;font-size:.8rem">🌸</span>
      <span class="spk" style="bottom:28%;left:4%;animation-delay:-3s">⭐</span>
      <span class="spk" style="bottom:12%;right:6%;animation-delay:-4.5s;font-size:.85rem">💫</span>
      <span class="spk" style="top:48%;left:2%;animation-delay:-2.5s;font-size:.9rem">🦋</span>
      <span class="spk" style="top:6%;left:48%;animation-delay:-5.5s;font-size:.7rem">✿</span>
    </div>
  </section>

  <!-- 关于 -->
  <section class="fs-section overlay-left" id="about">
    <div class="media-bg" data-parallax>
      <Picture
        src={HERO_IMAGES.about}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[800, 1600]}
        sizes="100vw"
        alt=""
        loading="lazy"
        decoding="async"
        quality={78}
      />
    </div>
    <div class="content">
      <div class="fs-copy">
        <div class="sec-tag" data-anim="fade-up">ABOUT ME</div>
        <h2 class="sec-title" data-anim="fade-up" data-delay style="--d:1">关于我</h2>
        <p class="sec-desc" data-anim="fade-up" data-delay style="--d:2">
          嗨~我是 buling，一个热爱编程和创作的初二学生。平时喜欢开发小游戏、做视频、玩 Minecraft。
        </p>
        <p class="sec-desc" data-anim="fade-up" data-delay style="--d:3;margin-top:10px">
          我相信代码可以创造无限可能，也希望用技术让更多人感受到快乐 ✨
        </p>
        <div class="fs-actions" data-anim="fade-up" data-delay style="--d:4">
          <a class="btn" href="/posts">读读我的文章 <Icon name="arrow-right" size={14} /></a>
          <a class="btn--ghost" href="/gallery">逛逛画廊</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 作品精选 -->
  <section class="fs-section overlay-bottom" id="projects">
    <div class="media-bg" data-parallax>
      <Picture
        src={HERO_IMAGES.works}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[800, 1600]}
        sizes="100vw"
        alt=""
        loading="lazy"
        decoding="async"
        quality={76}
      />
    </div>
    <div class="content">
      <div class="sec-tag" data-anim="fade-up">PROJECTS</div>
      <h2 class="sec-title" data-anim="fade-up" data-delay style="--d:1">我的作品</h2>
      <p class="sec-desc" data-anim="fade-up" data-delay style="--d:2">用心制作的每一个项目</p>
      <div class="home-works">
        {
          featuredWorks.map((work, index) => (
            <div data-anim="fade-up" data-delay style={`--d:${index + 3}`}>
              <WorkCard work={work} />
            </div>
          ))
        }
      </div>
      <div class="fs-actions fs-actions--center" data-anim="fade-up" data-delay style="--d:5">
        <a class="btn-static" href="/works">查看全部 <Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </section>

  <!-- 画廊预览 -->
  <section class="fs-section overlay-vignette" id="gallery">
    <div class="media-bg" data-parallax>
      <Picture
        src={HERO_IMAGES.gallery}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[800, 1600]}
        sizes="100vw"
        alt=""
        loading="lazy"
        decoding="async"
        quality={76}
      />
    </div>
    <div class="content">
      <div class="section-head section-head--center">
        <div class="sec-tag" data-anim="fade-up">GALLERY</div>
        <h2 class="sec-title" data-anim="fade-up" data-delay style="--d:1">图片画廊</h2>
        <p class="sec-desc" data-anim="fade-up" data-delay style="--d:2">记录美好瞬间</p>
      </div>
      <div data-anim="scale" data-delay style="--d:3">
        <GalleryGrid items={HOME_PREVIEW_ITEMS} compact />
      </div>
      <div class="fs-actions fs-actions--center" data-anim="fade-up" data-delay style="--d:4">
        <a class="btn-static" href="/gallery">查看全部 <Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="section home-posts" id="posts">
    <div class="container">
      <div class="section-head section-head--center">
        <div class="sec-tag" data-anim="fade-up">LATEST POSTS</div>
        <h2 class="sec-title" data-anim="fade-up" data-delay style="--d:1">最新文章</h2>
        <p class="sec-desc" data-anim="fade-up" data-delay style="--d:2">记录学习、项目与生活</p>
      </div>

      {
        latestPosts.length > 0 ? (
          <div class="post-grid">
            {latestPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <div class="empty-state__icon">📝</div>
            <p>还没有文章，先去写一篇吧。</p>
          </div>
        )
      }

      <div class="fs-actions fs-actions--center">
        <a class="btn-static" href="/posts">全部文章 <Icon name="arrow-right" size={14} /></a>
        <a class="btn--ghost" href="/rss.xml"><Icon name="rss" size={14} /> RSS 订阅</a>
      </div>
    </div>
  </section>

  <!-- 社交 -->
  <section class="fs-section overlay-full" id="social">
    <div class="media-bg" data-parallax>
      <Picture
        src={HERO_IMAGES.social}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[800, 1600]}
        sizes="100vw"
        alt=""
        loading="lazy"
        decoding="async"
        quality={76}
      />
    </div>
    <div class="content">
      <div class="section-head section-head--center">
        <div class="sec-tag" data-anim="fade-up">SOCIAL</div>
        <h2 class="sec-title" data-anim="fade-up" data-delay style="--d:1">关注我</h2>
        <p class="sec-desc" data-anim="fade-up" data-delay style="--d:2">和我成为朋友吧~</p>
      </div>
      <div class="social-row">
        {
          SITE.socials.map((social, index) => (
            <a
              class="soc-card"
              href={social.href}
              data-anim="fade-up"
              data-delay
              style={`--d:${index + 3}`}
              {...(social.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class:list={['soc-card__icon', `is-${social.icon}`]}>
                <Icon name={social.icon} size={20} />
              </span>
              <span class="soc-card__info">
                <span class="soc-card__title">{social.label}</span>
                <span class="soc-card__desc">{social.desc}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- Hero ---------------- */
  .home-hero {
    min-height: 100vh;
  }

  .home-hero .hero-bg::after {
    background: linear-gradient(
      180deg,
      rgba(10, 10, 15, 0.42) 0%,
      rgba(10, 10, 15, 0.68) 50%,
      var(--bg) 100%
    );
  }

  :global([data-theme='light']) .home-hero .hero-bg::after {
    background: linear-gradient(
      180deg,
      rgba(254, 246, 255, 0.22) 0%,
      rgba(254, 246, 255, 0.52) 50%,
      var(--bg) 100%
    );
  }

  .hero-content {
    max-width: 900px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.8rem;
    padding: 8px 22px;
    border-radius: 100px;
    font-weight: 700;
    margin-bottom: 28px;
    font-family: var(--font-display);
  }

  :global([data-theme='light']) .hero-badge {
    background: rgba(255, 255, 255, 0.5);
    color: var(--text);
    border-color: var(--border);
  }

  .hero-avatar {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    margin: 0 auto 28px;
    border: 3px solid rgba(255, 255, 255, 0.2);
    padding: 5px;
    background: var(--gradient);
    box-shadow: 0 0 60px var(--glow);
  }

  .hero-avatar :global(picture),
  .hero-avatar :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .home-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 16px;
    color: #fff;
  }

  :global([data-theme='light']) .home-hero h1 {
    color: var(--text);
  }

  .home-hero p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.72);
    max-width: 560px;
    margin: 0 auto 32px;
    line-height: 1.8;
  }

  :global([data-theme='light']) .home-hero p {
    color: var(--text-secondary);
  }

  .hero-tags {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .hero-tags span {
    padding: 8px 18px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 600;
    backdrop-filter: blur(8px);
    background: rgba(255, 255, 255, 0.06);
    transition:
      border-color 0.4s var(--ease-spring),
      color 0.4s,
      background 0.4s,
      transform 0.4s var(--ease-spring);
  }

  :global([data-theme='light']) .hero-tags span {
    border-color: var(--border);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.4);
  }

  .hero-tags span:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-bg);
    transform: translateY(-3px) scale(1.06);
  }

  .hero-scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.3s;
  }

  .hero-scroll span {
    font-size: 0.7rem;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .hero-scroll:hover {
    color: var(--primary);
  }

  .sparkles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .spk {
    position: absolute;
    font-size: 1rem;
    opacity: 0;
    animation: sparkle 8s ease-in-out infinite;
  }

  @keyframes sparkle {
    0%,
    100% {
      opacity: 0;
      transform: translateY(0) scale(0.4);
    }
    25% {
      opacity: 0.5;
      transform: translateY(-20px) scale(1);
    }
    50% {
      opacity: 0.2;
      transform: translateY(-10px) scale(0.8);
    }
    75% {
      opacity: 0.4;
      transform: translateY(-25px) scale(0.9);
    }
  }

  /* ---------------- 整屏区块 ---------------- */
  .fs-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .fs-section .content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 100px clamp(16px, 4vw, 32px);
  }

  .media-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    transform: scale(1.1);
    will-change: transform;
  }

  .media-bg :global(picture),
  .media-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .overlay-left::after,
  .overlay-bottom::after,
  .overlay-vignette::after,
  .overlay-full::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .overlay-left::after {
    background: linear-gradient(
      90deg,
      rgba(10, 10, 15, 0.9) 0%,
      rgba(10, 10, 15, 0.5) 52%,
      transparent 100%
    );
  }

  :global([data-theme='light']) .overlay-left::after {
    background: linear-gradient(
      90deg,
      rgba(254, 246, 255, 0.94) 0%,
      rgba(254, 246, 255, 0.6) 52%,
      transparent 100%
    );
  }

  .overlay-bottom::after {
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(10, 10, 15, 0.42) 40%,
      rgba(10, 10, 15, 0.9) 100%
    );
  }

  :global([data-theme='light']) .overlay-bottom::after {
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(254, 246, 255, 0.42) 40%,
      rgba(254, 246, 255, 0.92) 100%
    );
  }

  .overlay-vignette::after {
    background: radial-gradient(ellipse at center, transparent 18%, rgba(10, 10, 15, 0.72) 100%);
  }

  :global([data-theme='light']) .overlay-vignette::after {
    background: radial-gradient(ellipse at center, transparent 18%, rgba(254, 246, 255, 0.72) 100%);
  }

  .overlay-full::after {
    background: rgba(10, 10, 15, 0.8);
  }

  :global([data-theme='light']) .overlay-full::after {
    background: rgba(254, 246, 255, 0.78);
  }

  .fs-copy {
    max-width: 540px;
  }

  .fs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .fs-actions--center {
    justify-content: center;
    margin-top: 36px;
  }

  .home-works {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 22px;
  }

  .home-posts .post-grid {
    text-align: left;
  }

  /* ---------------- 社交卡片 ---------------- */
  .social-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .soc-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text);
    position: relative;
    overflow: hidden;
    transition:
      transform 0.45s var(--ease-spring),
      box-shadow 0.45s;
  }

  :global([data-theme='light']) .soc-card {
    background: rgba(255, 255, 255, 0.4);
    border-color: rgba(180, 130, 200, 0.1);
  }

  .soc-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gradient);
    opacity: 0;
    transition: opacity 0.4s;
  }

  .soc-card:hover::before {
    opacity: 0.12;
  }

  .soc-card:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.2);
    color: var(--text);
  }

  .soc-card__icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    position: relative;
    transition: transform 0.4s var(--ease-spring);
  }

  .soc-card:hover .soc-card__icon {
    transform: rotate(8deg) scale(1.15);
  }

  .soc-card__icon.is-bilibili {
    background: #fb7299;
    color: #fff;
  }

  .soc-card__icon.is-github {
    background: #333;
    color: #fff;
  }

  .soc-card__icon.is-mail {
    background: var(--gradient);
    color: #fff;
  }

  .soc-card__info {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .soc-card__title {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .soc-card__desc {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    margin-top: 2px;
  }

  /* ---------------- 响应式 ---------------- */
  @media (max-width: 900px) {
    .home-works {
      grid-template-columns: 1fr;
    }

    .social-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .home-hero h1 {
      font-size: 2.2rem;
    }

    .hero-avatar {
      width: 110px;
      height: 110px;
    }

    .fs-section .content {
      padding: 80px 16px;
    }

    .fs-section {
      min-height: 0;
    }

    .fs-section .content {
      padding-block: 96px;
    }

    .hero-scroll {
      display: none;
    }
  }
</style>
