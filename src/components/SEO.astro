---
/**
 * SEO <head>：标题 / 描述 / Open Graph / Twitter / canonical / JSON-LD / RSS
 * 所有页面统一走这里，避免每页重复维护 meta。
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  preloadImage?: ImageMetadata;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
  preloadImage,
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} · ${SITE.shortTitle}`;
const pathname = Astro.url.pathname;
// 404 页不输出 canonical，避免把错误页当成正常页面收录
const is404 = pathname === '/404' || pathname === '/404/';
const isFile = /\.(?:xml|txt|json|html)$/i.test(pathname);
const canonicalPath = !isFile && !pathname.endsWith('/') ? `${pathname}/` : pathname;
const canonical = new URL(canonicalPath, SITE.url).href;

// 分享图：优先用页面传入的图片；否则用构建期优化过的头像（1200×630 jpeg）
const ogImage = image
  ? new URL(typeof image === 'string' ? image : image.src, SITE.url).href
  : await (async () => {
      const avatar = (await import('@/assets/images/avatar.jpg')).default;
      const optimized = await getImage({
        src: avatar,
        width: 1200,
        height: 630,
        fit: 'cover',
        format: 'jpeg',
        quality: 82,
      });
      return new URL(optimized.src, SITE.url).href;
    })();

let preloadHref: string | undefined;
if (preloadImage) {
  const optimized = await getImage({ src: preloadImage, width: 1600, format: 'webp', quality: 78 });
  preloadHref = optimized.src;
}

const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<meta name="keywords" content={(tags.length ? tags : SITE.keywords).join(', ')} />
<meta name="theme-color" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content={SITE.themeColor.light} media="(prefers-color-scheme: light)" />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex, follow" />}

{!is404 && <link rel="canonical" href={canonical} />}
<link
  rel="icon"
  href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌸</text></svg>"
/>
<link rel="sitemap" href="/sitemap.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} · RSS`} href="/rss.xml" />
{preloadHref && <link rel="preload" as="image" href={preloadHref} fetchpriority="high" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={SITE.locale} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  jsonLdBlocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))
}
