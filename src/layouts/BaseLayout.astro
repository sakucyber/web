---
/**
 * 全站基础布局
 * - <head> 走 SEO 组件，主题初始化脚本在渲染前同步执行（外部文件，满足严格 CSP）
 * - 统一挂载加载遮罩 / 光标 / 粒子 / 返回顶部 / 灯箱等全站 UI
 * - `bare` 模式给小游戏类全屏页面使用（不渲染导航与页脚）
 */
import '@/styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE } from '@/config/site';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SEO from '@/components/SEO.astro';
import Icon from '@/components/Icon.astro';
import Lightbox from '@/components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  preloadImage?: ImageMetadata;
  bodyClass?: string;
  bare?: boolean;
  /** 是否需要灯箱外壳，默认按页面自行引入 */
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  tags,
  jsonLd,
  preloadImage,
  bodyClass,
  bare = false,
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} data-theme={SITE.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- 首屏前同步应用主题，避免深色站闪白；外部文件，CSP 只允许 'self' -->
    <script is:inline src="/scripts/theme-init.js"></script>
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      jsonLd={jsonLd}
      preloadImage={preloadImage}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到主要内容</a>

    <div class="loading" id="loading" aria-hidden="true">
      <div class="loading-ring"></div>
      <span>✨ 加载中...</span>
    </div>
    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
    <div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>
    <div class="cursor-ring" id="cursorRing" aria-hidden="true"></div>
    <div class="particles" id="particles" data-particles="12" aria-hidden="true"></div>

    {!bare && <Header />}

    {
      bare ? (
        <slot />
      ) : (
        <main id="main">
          <slot />
        </main>
      )
    }

    {!bare && <Footer />}

    <button class="btt" id="btt" type="button" aria-label="回到顶部">
      <Icon name="arrow-up" size={18} />
    </button>

    <Lightbox />

    <noscript>
      <style>
        .loading {
          display: none !important;
        }
      </style>
    </noscript>

    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
