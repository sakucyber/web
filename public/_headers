// Cloudflare Pages 响应头配置
// 文档：https://developers.cloudflare.com/pages/configuration/headers/
// 规则按顺序叠加，后面的规则会覆盖前面同名的头。

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

# 带内容哈希的构建产物：一年 immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 站点资源（头像等未指纹化的文件）：一周缓存
/images/*
  Cache-Control: public, max-age=604800

# 小游戏构建产物是 HTML，保持回源校验
/games/*
  Cache-Control: public, max-age=0, must-revalidate

# 小玩具页不收录（页面 meta 里也有 noindex，双保险）
/project/ai
  X-Robots-Tag: noindex, follow

/project/ai/*
  X-Robots-Tag: noindex, follow

/project/femboy
  X-Robots-Tag: noindex, follow

/project/femboy/*
  X-Robots-Tag: noindex, follow

# 404 不要被缓存
/404.html
  Cache-Control: no-cache
